        "breaks",
        "ramp",
        "scale_scope",
        "range",
        "unit"
      ],
      "defauts": {
        "side": "right",
        "width": 13,
        "opacity": 100,
        "gap": 4,
        "visible": true,
        "fill": "scale",
        "stroke": "auto",
        "export": "visible",
        "filter": null,
        "tooltip": {
          "fields": []
        },
        "label_text": {
          "size": 9,
          "color": "ink_2",
          "position": "outer",
          "offset": 6
        }
      }
    },
    "media": {
      "specific_autorise": [
        "thumb_size",
        "resolution",
        "alt_text"
      ],
      "defauts": {
        "side": "right",
        "width": 16,
        "opacity": 100,
        "gap": 4,
        "visible": true,
        "fill": "fixed",
        "stroke": "auto",
        "export": "visible",
        "filter": null,
        "tooltip": {
          "fields": []
        },
        "label_text": {
          "size": 9,
          "color": "ink_2",
          "position": "outer",
          "offset": 6
        }
      }
    }
  },
  "pistes": [
