{
  "$comment": "Source de vérité des pistes. Toute piste absente d'ici n'existe pas. Toute clé absente du contrat est refusée.",
  "contrat": {
    "version": "1.0",
    "champs": {
      "id": {
        "type": "slug",
        "defaut": null,
        "herite": false,
        "note": "stable, jamais traduit, jamais renommé"
      },
      "label": {
        "type": "string",
        "defaut": null,
        "herite": false,
        "note": "vient du lexique FR, jamais saisi librement"
      },
      "family": {
        "type": "enum",
        "valeurs": [
          "structurelle",
          "categorielle",
          "quantitative",
          "media"
        ],
        "defaut": null,
        "herite": false
      },
      "visible": {
        "type": "bool",
        "defaut": true,
        "herite": true,
        "note": "hérité de la famille"
      },
      "order": {
        "type": "int",
        "defaut": null,
        "herite": false,
        "note": "entier unique par coupe, 10, 20, 30…"
      },
      "side": {
        "type": "enum",
        "valeurs": [
          "left",
          "right",
          "overlay"
        ],
        "defaut": "left",
        "herite": true
      },
      "width": {
        "type": "int",
        "min": 4,
        "max": 120,
        "unite": "px",
        "defaut": 12,
        "herite": true
      },
      "gap": {
        "type": "int",
        "min": 0,
        "max": 40,
        "unite": "px",
        "defaut": 4,
        "herite": true
      },
      "opacity": {
        "type": "int",
        "min": 0,
        "max": 100,
        "unite": "%",
        "defaut": 100,
        "herite": true
      },
      "fill": {
        "type": "enum",
        "valeurs": [
          "reference",
          "scale",
          "fixed"
        ],
        "defaut": "reference",
        "herite": true,
        "note": "reference = lit le Référentiel, scale = rampe calculée"
      },
      "stroke": {
        "type": "enum",
        "valeurs": [
          "auto",
          "fixed"
        ],
        "defaut": "auto",
        "herite": true
      },
      "label_text": {
        "type": "obj",
        "cles": [
          "size",
          "color",
          "position",
          "offset"
        ],
        "defaut": {
          "size": 9,
          "color": "ink_2",
          "position": "outer",
          "offset": 6
        },
        "herite": true
      },
      "tooltip": {
        "type": "obj",
        "cles": [
          "fields"
        ],
        "defaut": {
          "fields": []
        },
        "herite": true
      },
      "filter": {
        "type": "expr",
        "defaut": null,
        "herite": true,
        "note": "expression de domaine, jamais du code"
      },
      "export": {
        "type": "enum",
        "valeurs": [
          "visible",
          "hidden",
          "simplified"
        ],
        "defaut": "visible",
        "herite": true
      }
    },
    "regles": [
      "15 champs communs, exactement (14 emplacements d'origine + family, décision D-017). Aucun champ en plus.",
      "Un champ commun ne peut jamais être redéclaré dans specific.",
      "Les valeurs de type enum sont fermées : toute autre valeur est un bug.",
      "width/opacity/side/gap/export sont hértiables ; id/label/order/family ne le sont pas.",
      "La résolution se fait famille -> piste ; une piste sans valeur explicite prend celle de la famille.",
      "Aucune vue ne stocke de copie : 2D, 3D, légende, export et carte lisent le même objet résolu."
    ]
  },
  "familles": {
    "structurelle": {
      "specific_autorise": [
        "tick_step",
        "label_every",
        "line_style",
        "dash",
        "rule_ids",
        "label_position"
      ],
      "defauts": {
        "side": "left",
        "width": 20,
        "opacity": 100,
        "gap": 4,
        "visible": true,
        "fill": "fixed",
        "stroke": "auto",
        "export": "visible",
        "filter": null,
        "tooltip": {
          "fields": []
        },
        "label_text": {
          "size": 9,
          "color": "ink_2",
          "position": "outer",
          "offset": 6
        }
      }
    },
    "categorielle": {
      "specific_autorise": [
        "pattern",
        "legend_order",
        "hatch_scale"
